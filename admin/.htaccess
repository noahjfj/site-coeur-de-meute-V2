# Protection de l'espace administrateur (serveurs Apache)
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(acces\.php|.*\.tmp-.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
